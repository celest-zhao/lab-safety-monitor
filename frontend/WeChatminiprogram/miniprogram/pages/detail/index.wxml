<!-- 设备详情页 -->
<view class="page page-with-safe theme-{{theme}}">
  <view wx:if="{{error}}" class="banner banner-danger" bindtap="onRetry">
    <view class="banner-dot"></view>
    <view class="banner-text">{{error}}　点这里重试</view>
  </view>

  <!-- 骨架 -->
  <block wx:if="{{loading}}">
    <view class="card">
      <view class="skeleton" style="width: 240rpx; height: 40rpx"></view>
      <view class="skeleton mt-16" style="width: 100%; height: 120rpx"></view>
    </view>
    <view class="card">
      <view class="skeleton" style="width: 100%; height: 220rpx"></view>
    </view>
  </block>

  <block wx:if="{{!loading && device}}">
    <!-- 设备概要 -->
    <view class="card">
      <view class="row-between">
        <view class="flex-1">
          <view class="card-title-strong ellipsis">{{device.name}}</view>
          <view class="card-sub ellipsis">设备 ID：{{deviceId}}</view>
        </view>
        <view class="tag {{device.statusClass}}">{{device.statusText}}</view>
      </view>
      <view class="divider"></view>
      <view class="row-between">
        <text class="fs-24 text-hint">最后更新</text>
        <text class="fs-26 text-sub">{{updatedText}}</text>
      </view>
    </view>

    <!-- 远程控制 -->
    <view class="card">
      <view class="card-hd">
        <text class="card-title">远程控制</text>
        <text class="fs-22 text-hint">{{online ? '设备在线' : '离线，指令等上线后执行'}}</text>
      </view>

      <view class="switch-row">
        <view class="switch-icon {{fillOn ? 'switch-icon-on' : ''}}">光</view>
        <view class="switch-main">
          <view class="switch-name">补光灯</view>
          <view class="switch-desc">
            {{fillPending ? '指令下发中…' : (fillOn ? '已开启' : '已关闭')}}
          </view>
        </view>
        <switch
          checked="{{fillOn}}"
          disabled="{{fillPending}}"
          color="{{switchColor}}"
          data-field="Fill"
          bindchange="onToggle"
        />
      </view>

      <view class="divider"></view>

      <view class="switch-row">
        <view class="switch-icon {{fanOn ? 'switch-icon-on' : ''}}">风</view>
        <view class="switch-main">
          <view class="switch-name">风扇</view>
          <view class="switch-desc">
            {{fanPending ? '指令下发中…' : (fanOn ? '已开启' : '已关闭')}}
          </view>
        </view>
        <switch
          checked="{{fanOn}}"
          disabled="{{fanPending}}"
          color="{{switchColor}}"
          data-field="Fan"
          bindchange="onToggle"
        />
      </view>
    </view>

    <!-- 核心指标 -->
    <view class="card">
      <view class="card-hd">
        <text class="card-title">传感数据</text>
      </view>
      <view class="metric-grid">
        <view class="metric" wx:for="{{coreMetrics}}" wx:for-item="m" wx:key="key">
          <view class="metric-inner">
            <view class="metric-label">{{m.label}}</view>
            <view class="metric-value-row">
              <text class="{{m.big ? 'metric-value' : 'metric-value-sm'}} t-{{m.tone}}">{{m.value}}</text>
              <text wx:if="{{m.unit}}" class="metric-unit">{{m.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 更多指标（折叠） -->
    <view class="card">
      <view class="row-between" bindtap="toggleExtra">
        <text class="card-title">更多指标</text>
        <text class="fs-24 text-hint">{{extraOpen ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{extraOpen}}" class="mt-16">
        <view class="list-row" wx:for="{{extraMetrics}}" wx:key="key">
          <text class="list-label">{{item.label}}</text>
          <text class="list-value">
            <text class="t-{{item.tone}}">{{item.value}}</text>
            <text wx:if="{{item.unit}}">{{item.unit}}</text>
          </text>
        </view>
      </view>
    </view>

    <!-- 最近报警 -->
    <view class="card">
      <view class="card-hd">
        <text class="card-title">最近报警</text>
        <text class="fs-22 text-hint" bindtap="goAlarm">全部 ›</text>
      </view>

      <view wx:if="{{!alarms.length}}" class="fs-26 text-hint">这台设备暂无报警记录</view>

      <view wx:for="{{alarms}}" wx:key="_id" class="list-row">
        <view class="flex-1">
          <view class="row-center">
            <view
              class="tag {{item.level === 'severe' ? 'tag-error' : item.level === 'warning' ? 'tag-warning' : 'tag-muted'}}"
            >{{item.levelText}}</view>
            <text class="alarm-title">{{item.title}}</text>
          </view>
          <view class="fs-22 text-hint mt-8">{{item.detail}}</view>
        </view>
        <text class="fs-22 text-hint alarm-time">{{item.timeText}}</text>
      </view>
    </view>
  </block>
</view>
