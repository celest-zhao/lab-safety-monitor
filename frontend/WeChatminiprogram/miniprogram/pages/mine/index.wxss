/* 我的页 */

.profile {
  display: flex;
  align-items: center;
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 38rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.profile-sub {
  font-size: 23rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  padding: 8rpx 24rpx;
  line-height: 1.6;
}

/* 外观模式：三档分段控件 */
.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 16rpx;
  background: var(--item-bg);
  border: 1rpx solid var(--line-soft);
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: var(--text-sub);
  transition: background 0.18s ease, color 0.18s ease;
}

.seg-item.on {
  background: var(--chip-on-bg);
  color: var(--chip-on-text);
  font-weight: 600;
  box-shadow: var(--primary-glow);
}

/* 「外观」卡片右上角的状态文案：贴在标题行里，去掉 card-sub 的默认上边距 */
.card-hd .card-sub {
  margin-top: 0;
}

.seg-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--text-hint);
}

/* 自检结果 */
.health-box {
  padding: 20rpx 4rpx 4rpx;
}
.health-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text);
  white-space: pre-wrap;
}
.health-advice {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--error-text);
}
