/**
 * 全局样式与设计 Token（双主题，2026-11-06）
 * 画布 375px = 750rpx（1px = 2rpx）
 *
 * 两套主题，可在「我的 → 外观」里选：跟随系统 / 浅色 / 深色
 *   浅色（默认）—— 缤纷糖果：浅灰蓝底 + 蓝紫渐变主卡 + 每个指标一个专属色
 *   深色（.page.theme-dark）—— 深色玻璃：深底 + 毛玻璃卡片 + 细边微光
 *
 * 具体哪套生效由 utils/theme.js 决定，页面根节点 class 写 `theme-{{theme}}`。
 * 写样式时**只用变量、不写死色值**，否则切换主题时会有一块颜色不跟着变。
 * 需要新增颜色时先在这里加 token，再在下方两个主题块里各给一个值。
 */

page {
  /* ======================= 浅色主题（默认） ======================= */

  /* 底色与文字 */
  --bg: #f7f8fc;
  --bg-image: radial-gradient(1200rpx 600rpx at 15% -8%, rgba(76, 111, 255, 0.1), transparent 70%),
    radial-gradient(900rpx 500rpx at 100% 0%, rgba(240, 78, 140, 0.08), transparent 66%);
  --text: #1a1f36;
  --text-sub: #55607a;
  --text-hint: #6b7488; /* 对比度 4.69:1（22rpx 小字也达标），再浅就发灰看不清 */

  /* 卡片 */
  --card: #ffffff;
  --card-press: rgba(26, 31, 54, 0.035);
  --line: rgba(26, 31, 54, 0.07);
  --line-soft: rgba(26, 31, 54, 0.06);
  --card-shadow: 0 3rpx 12rpx rgba(26, 31, 54, 0.05), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  --item-bg: #f7f8fc;

  /* 主色 */
  --primary: #4c6fff;
  --primary-text: #3b5ee0;
  --primary-soft: rgba(76, 111, 255, 0.1);
  --primary-soft-strong: rgba(76, 111, 255, 0.16);
  --primary-line: rgba(76, 111, 255, 0.26);
  --primary-glow: 0 0 20rpx rgba(76, 111, 255, 0.2);

  /* 语义色 */
  --success: #0b8f53;
  --success-text: #0b8f53;
  --success-bg: rgba(18, 183, 106, 0.1);
  --success-line: rgba(18, 183, 106, 0.24);

  --warning: #b37505;
  --warning-text: #b37505;
  --warning-bg: rgba(245, 165, 36, 0.12);
  --warning-line: rgba(245, 165, 36, 0.28);

  --error: #d92d20;
  --error-text: #d92d20;
  --error-text-soft: #7a4a4d;
  --error-bg: rgba(240, 68, 56, 0.08);
  --error-line: rgba(240, 68, 56, 0.22);

  --muted-bg: rgba(26, 31, 54, 0.05);
  --muted-text: #6b7488;

  /* 顶部主卡（蓝紫渐变） */
  --hero-bg: linear-gradient(135deg, #4c6fff 0%, #6a5bff 52%, #8b5cf6 100%);
  --hero-line: rgba(255, 255, 255, 0.18);
  --hero-shadow: 0 16rpx 36rpx rgba(76, 111, 255, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  --hero-fg: #ffffff;
  /* 主卡底色是饱和蓝紫渐变，卡内小字必须跟着变浅，否则白底用的深灰字压上去等于看不见 */
  --hero-sub: rgba(255, 255, 255, 0.92);
  --hero-sub-weak: rgba(255, 255, 255, 0.86);
  --hero-chip-bg: rgba(255, 255, 255, 0.22);
  --hero-glow: radial-gradient(circle, rgba(255, 255, 255, 0.34), transparent 68%);
  /* 卡内数值语义色：渐变上的浅色调，不能用页面级 t-* 的深色 */
  --hero-t-normal: #ffffff;
  --hero-t-success: #d3fceb;
  --hero-t-warning: #ffe6b8;
  --hero-t-error: #ffd3d4;
  --hero-t-muted: rgba(255, 255, 255, 0.8);
  --dot-online: #3ddc97;
  --dot-offline: rgba(255, 255, 255, 0.55);

  /* 按钮 */
  --btn-grad: linear-gradient(135deg, #4c6fff, #7a5af8);
  --btn-grad-press: linear-gradient(135deg, #4062e8, #6c4ee8);
  --btn-shadow: 0 10rpx 26rpx rgba(76, 111, 255, 0.3);
  --btn-ghost-bg: #ffffff;
  --btn-ghost-text: #3b5ee0;
  --btn-ghost-line: rgba(76, 111, 255, 0.24);
  --btn-ghost-press: rgba(76, 111, 255, 0.08);

  /* chips */
  --chip-bg: #ffffff;
  --chip-line: rgba(26, 31, 54, 0.08);
  --chip-on-bg: #4c6fff;
  --chip-on-line: #4c6fff;
  --chip-on-text: #ffffff;

  /* 弹层 */
  --sheet-bg: #ffffff;
  --sheet-line: rgba(26, 31, 54, 0.06);
  --sheet-shadow: 0 -12rpx 40rpx rgba(26, 31, 54, 0.14);
  --mask: rgba(26, 31, 54, 0.34);

  /* 骨架屏 */
  --sk-1: rgba(26, 31, 54, 0.05);
  --sk-2: rgba(26, 31, 54, 0.1);

  /* 控制开关 */
  --ctrl-bg: rgba(26, 31, 54, 0.04);
  --ctrl-line: rgba(26, 31, 54, 0.07);
  --ctrl-on-bg: linear-gradient(135deg, #4c6fff, #7a5af8);
  --ctrl-on-line: #4c6fff;
  --ctrl-on-text: #ffffff;
  --ctrl-on-shadow: 0 6rpx 16rpx rgba(76, 111, 255, 0.28);

  /* 删除按钮 */
  --del-bg: #f04438;
  --del-shadow: 0 6rpx 16rpx rgba(240, 68, 56, 0.3);

  /* 模块默认色（会被 .mod-c-* 覆盖） */
  --mod-bg: #ffffff;
  --mod-line: rgba(26, 31, 54, 0.06);
  --mod-tone: #1a1f36;

  background: var(--bg);
  background-image: var(--bg-image);
  background-repeat: no-repeat;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ======================= 深色主题 ======================= */

/**
 * 挂在页面根节点（.page.theme-dark）上，而不是用系统媒体查询：
 * 手动选「浅色 / 深色」时，媒体查询会和用户的选择打架。
 * 系统深色 + 用户选浅色 = 页面必须还是浅色，只有类能表达这个意思。
 * 具体选哪套由 utils/theme.js 决定，页面根节点 class 写 theme-{{theme}}。
 */

.page.theme-dark {
  /**
   * 深色主题：回到 v1「深空玻璃」（2026-11-06 用户指定回退）
   *
   * 中间试过极光渐变、星空、藏青夜色三版，用户都否了，明确"不如之前留的那一版"。
   * v1 指的是 styles/v1-dark/ 里那份 19:30 的备份：近黑底 + 玻璃卡。
   * 这里按 v1 的视觉结果重写 token，但保留双主题结构（手动切换仍然可用）。
   *
   * 为什么不直接覆盖备份文件：备份是单主题写法（page 里直接写死深色），
   * 现在深色挂在 .page.theme-dark 上、和浅色共用同一套 token 名，
   * 直接覆盖会丢掉 theme.json / utils/theme.js 那套切换机制。
   */

    /* 页面底：近黑蓝，两团柔光（蓝在左上、绿在右上），v1 原值 */
    --bg: #070a12;
    --bg-image: radial-gradient(1200rpx 600rpx at 20% -10%, rgba(76, 141, 255, 0.16), transparent 70%),
      radial-gradient(900rpx 500rpx at 100% 0%, rgba(53, 211, 154, 0.1), transparent 65%);

    /* 文字三级：v1 原值 */
    --text: #f2f5fa;
    --text-sub: #a7b0c4;
    --text-hint: #6b768c;

    /* 卡片回到 v1 的半透明白玻璃（.045）。这也是 v1 的"高级感"来源：
       卡片不是一块实色板，而是浮在夜色上的一层薄玻璃，边缘有一道 1rpx 内高光 */
    --card: rgba(255, 255, 255, 0.045);
    --card-press: rgba(255, 255, 255, 0.075);
    --line: rgba(255, 255, 255, 0.08);
    --line-soft: rgba(255, 255, 255, 0.05);
    --card-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.36), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
    --item-bg: rgba(255, 255, 255, 0.05);

    /* 主色：v1 的 #4c8dff */
    --primary: #4c8dff;
    --primary-text: #9cc2ff;
    --primary-soft: rgba(76, 141, 255, 0.16);
    --primary-soft-strong: rgba(76, 141, 255, 0.26);
    --primary-line: rgba(76, 141, 255, 0.45);
    --primary-glow: 0 0 20rpx rgba(76, 141, 255, 0.28);

    /* 语义色回到 v1 的 #35d39a 绿（上一版改成青绿是为了配藏青底，底色回黑绿就要回来） */
    --success: #35d39a;
    --success-text: #6fe0b6;
    --success-bg: rgba(53, 211, 154, 0.14);
    --success-line: rgba(53, 211, 154, 0.34);

    --warning: #ffb020;
    --warning-text: #ffc65c;
    --warning-bg: rgba(255, 176, 32, 0.12);
    --warning-line: rgba(255, 176, 32, 0.28);

    --error: #ff5d62;
    --error-text: #ff9a9d;
    --error-text-soft: #d9b6b7;
    --error-bg: rgba(255, 93, 98, 0.12);
    --error-line: rgba(255, 93, 98, 0.3);

    --muted-bg: rgba(255, 255, 255, 0.06);
    --muted-text: #8e99ae;

    /* 主卡：v1 的 140deg 蓝→绿玻璃渐变（蓝 22% → 绿 8% → 白 3%），配右上那团圆形蓝光斑 */
    --hero-bg: linear-gradient(140deg, rgba(76, 141, 255, 0.22), rgba(53, 211, 154, 0.08) 58%, rgba(255, 255, 255, 0.03));
    --hero-line: rgba(255, 255, 255, 0.1);
    --hero-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.12), 0 16rpx 40rpx rgba(0, 0, 0, 0.4);
    --hero-fg: #ffffff;
    --hero-sub: rgba(255, 255, 255, 0.72);
    --hero-sub-weak: rgba(255, 255, 255, 0.62);
    --hero-chip-bg: rgba(255, 255, 255, 0.1);
    --hero-glow: radial-gradient(circle, rgba(76, 141, 255, 0.45), transparent 68%);
    --hero-t-normal: #ffffff;
    --hero-t-success: #6fe0b6;
    --hero-t-warning: #ffd98a;
    --hero-t-error: #ffb3b6;
    --hero-t-muted: rgba(255, 255, 255, 0.7);
    --dot-online: #35d39a;
    --dot-offline: #8e99ae;

    --btn-grad: linear-gradient(135deg, #4c8dff, #6aa5ff);
    --btn-grad-press: linear-gradient(135deg, #3f7df0, #5b95f0);
    --btn-shadow: 0 10rpx 26rpx rgba(76, 141, 255, 0.3);
    --btn-ghost-bg: rgba(255, 255, 255, 0.05);
    --btn-ghost-text: #9cc2ff;
    --btn-ghost-line: rgba(76, 141, 255, 0.34);
    --btn-ghost-press: rgba(76, 141, 255, 0.14);

    --chip-bg: rgba(255, 255, 255, 0.05);
    --chip-line: rgba(255, 255, 255, 0.08);
    --chip-on-bg: rgba(76, 141, 255, 0.22);
    --chip-on-line: rgba(76, 141, 255, 0.5);
    --chip-on-text: #ffffff;

    /* 弹层：v1 没有弹层，取备份里的 --card-solid #121A2B，比玻璃卡实一档，才压得住遮罩 */
    --sheet-bg: #121a2b;
    --sheet-line: rgba(255, 255, 255, 0.1);
    --sheet-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.55);
    --mask: rgba(4, 7, 14, 0.66);

    --sk-1: rgba(255, 255, 255, 0.045);
    --sk-2: rgba(255, 255, 255, 0.08);

    --ctrl-bg: rgba(255, 255, 255, 0.05);
    --ctrl-line: rgba(255, 255, 255, 0.08);
    --ctrl-on-bg: rgba(76, 141, 255, 0.22);
    --ctrl-on-line: rgba(76, 141, 255, 0.5);
    --ctrl-on-text: #d6e5ff;
    --ctrl-on-shadow: 0 0 22rpx rgba(76, 141, 255, 0.28);

    --del-bg: rgba(255, 93, 98, 0.9);
    --del-shadow: 0 6rpx 16rpx rgba(255, 93, 98, 0.35);

    --mod-bg: rgba(255, 255, 255, 0.045);
    --mod-line: rgba(255, 255, 255, 0.08);
    --mod-tone: #f2f5fa;
}

view,
text {
  box-sizing: border-box;
}

/* ------------------------------- 页面容器 ------------------------------- */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  /* 根节点自己铺底：切到 .theme-dark 时 page 元素仍是浅色，
     不在这里重铺，卡片缝隙与页面底部就会漏出浅色 */
  background: var(--bg);
  background-image: var(--bg-image);
  background-repeat: no-repeat;
  /**
   * color 必须在这里再声明一次。
   * 主题变量挂在 .page.theme-dark 上，但 color 属性是在 page 元素上算出来的：
   * page 元素只看到浅色那套 --text（#1a1f36），子节点再改变量也改不回来。
   * 少了这一行，深色主题下所有没写 color 的文字（弹层标题、模块名…）都是深灰压深底，等于看不见。
   */
  color: var(--text);
}

.page-with-safe {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

/* ------------------------------- 提示横幅 ------------------------------- */

.banner {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  font-size: 25rpx;
  line-height: 1.45;
  backdrop-filter: blur(12rpx);
}

.banner-warn {
  background: var(--warning-bg);
  color: var(--warning-text);
  border: 1rpx solid var(--warning-line);
}

.banner-danger {
  background: var(--error-bg);
  color: var(--error-text);
  border: 1rpx solid var(--error-line);
}

.banner-info {
  background: var(--primary-soft);
  color: var(--primary-text);
  border: 1rpx solid var(--primary-line);
}

.banner-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: currentColor;
  box-shadow: 0 0 12rpx currentColor;
}

.banner-text {
  flex: 1;
}

/* 错误详情框：把接口返回的原始报错展示出来，方便定位 */

.err-box {
  background: var(--error-bg);
  border: 1rpx solid var(--error-line);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.err-label {
  font-size: 23rpx;
  color: var(--error-text);
  font-weight: 600;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.err-text {
  font-size: 22rpx;
  line-height: 1.55;
  color: var(--error-text-soft);
  word-break: break-all;
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
}

.err-tip {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--error-line);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-hint);
}

/* --------------------------------- 卡片 --------------------------------- */

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  backdrop-filter: blur(20rpx);
}

.card-tap:active {
  background: var(--card-press);
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 0.5rpx;
}

.card-title-strong {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.card-sub {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* --------------------------------- 标签 --------------------------------- */

.tag {
  display: inline-block;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 500;
}

.tag-success {
  background: var(--success-bg);
  color: var(--success-text);
}

.tag-warning {
  background: var(--warning-bg);
  color: var(--warning-text);
}

.tag-error {
  background: var(--error-bg);
  color: var(--error-text);
}

.tag-muted {
  background: var(--muted-bg);
  color: var(--muted-text);
}

.tag-primary {
  background: var(--primary-soft);
  color: var(--primary-text);
}

/* --------------------------------- 指标 --------------------------------- */

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.metric {
  width: 33.333%;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.metric-inner {
  background: var(--item-bg);
  border: 1rpx solid var(--line-soft);
  border-radius: 18rpx;
  padding: 18rpx 16rpx;
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.metric-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

.metric-value-row {
  display: flex;
  align-items: baseline;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
}

.metric-value-sm {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.metric-unit {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-left: 4rpx;
}

/* 数值语义色 */
.t-normal {
  color: var(--text);
}

.t-success {
  color: var(--success);
}

.t-warning {
  color: var(--warning);
}

.t-error {
  color: var(--error);
}

.t-muted {
  color: var(--text-hint);
}

.t-primary {
  color: var(--primary);
}

/* --------------------------------- 列表 --------------------------------- */

.list-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: none;
}

.list-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.list-value {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-left: 24rpx;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

.list-arrow {
  margin-left: 12rpx;
  color: var(--text-hint);
  font-size: 26rpx;
}

/* --------------------------------- 按钮 --------------------------------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: var(--btn-grad);
  color: #ffffff;
  box-shadow: var(--btn-shadow);
}

.btn-primary:active {
  background: var(--btn-grad-press);
}

.btn-ghost {
  background: var(--btn-ghost-bg);
  color: var(--btn-ghost-text);
  border: 1rpx solid var(--btn-ghost-line);
}

.btn-ghost:active {
  background: var(--btn-ghost-press);
}

.btn-disabled {
  opacity: 0.5;
}

/* --------------------------------- 开关 --------------------------------- */

.switch-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 8rpx 0;
}

.switch-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  background: var(--item-bg);
  color: var(--text-hint);
}

.switch-icon-on {
  background: var(--primary-soft);
  color: var(--primary-text);
  box-shadow: var(--primary-glow);
}

.switch-main {
  flex: 1;
  min-width: 0;
}

.switch-name {
  font-size: 30rpx;
  font-weight: 500;
}

.switch-desc {
  font-size: 23rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

/* --------------------------------- 空态 --------------------------------- */

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

/* ------------------------------- 骨架占位 ------------------------------- */

.skeleton {
  background: linear-gradient(90deg, var(--sk-1) 25%, var(--sk-2) 37%, var(--sk-1) 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 12rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

/* ------------------------------- 微小工具 ------------------------------- */

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.text-hint {
  color: var(--text-hint);
}

.text-sub {
  color: var(--text-sub);
}

.fs-22 {
  font-size: 22rpx;
}

.fs-24 {
  font-size: 24rpx;
}

.fs-26 {
  font-size: 26rpx;
}

.mt-8 {
  margin-top: 8rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ======================== 首页看板 ======================== */

/* 顶部主卡：设备名 + 在线状态 + 更新时间 */
.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 32rpx 30rpx;
  border-radius: 32rpx;
  margin-bottom: 26rpx;
  background: var(--hero-bg);
  border: 1rpx solid var(--hero-line);
  box-shadow: var(--hero-shadow);
  color: var(--hero-fg);
}

.hero-glow {
  position: absolute;
  top: -90rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: var(--hero-glow);
  pointer-events: none;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
}

.hero-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--hero-sub);
}

.hero-status {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--hero-chip-bg);
  color: var(--hero-fg);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: currentColor;
}

.dot-online {
  color: var(--dot-online);
  box-shadow: 0 0 14rpx currentColor;
}

.dot-offline {
  color: var(--dot-offline);
}

.hero-big {
  margin-top: 26rpx;
  display: flex;
  align-items: flex-end;
}

.hero-big-value {
  font-size: 84rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.hero-big-unit {
  font-size: 28rpx;
  color: var(--hero-sub);
  margin-left: 8rpx;
  margin-bottom: 8rpx;
}

.hero-big-label {
  font-size: 23rpx;
  color: var(--hero-sub-weak);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

/* ------------------------------------------------------------------
 * 主卡内的文字配色
 * 主卡底色是饱和渐变（浅色）或深玻璃（深色），页面级的深色文字压上去会直接消失。
 * 这里把卡内所有文字统一翻成卡内浅色，数值仍保留语义（绿 / 黄 / 红）。
 * ------------------------------------------------------------------ */

.hero .text-hint,
.hero .text-sub {
  color: var(--hero-sub);
}

.hero .t-normal {
  color: var(--hero-t-normal);
}

.hero .t-success {
  color: var(--hero-t-success);
}

.hero .t-warning {
  color: var(--hero-t-warning);
}

.hero .t-error {
  color: var(--hero-t-error);
}

.hero .t-primary {
  color: var(--hero-fg);
}

.hero .t-muted {
  color: var(--hero-t-muted);
}

/* 卡内小标签（AI 评分的「正常 / 注意 / 危险」）：白底深字，
   两种主题都清楚——卡底无论蓝紫渐变还是深玻璃，白胶囊都压得住 */
.hero .tag {
  background: rgba(255, 255, 255, 0.92);
  color: #1a1f36;
  font-weight: 600;
}

/* 深色主卡标签：回到 v1 的白玻璃胶囊（.1 白底 + 白字），跟在 v1 主卡上一致 */
.page.theme-dark .hero .tag {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

/* 安全语义色：跟着 v1 的 #35d39a 走 */
.page.theme-dark .hero .tag-success {
  color: #6fe0b6;
  border-color: rgba(111, 224, 182, 0.3);
}

.page.theme-dark .hero .tag-warning {
  color: #ffe0a0;
  border-color: rgba(255, 224, 160, 0.35);
}

.page.theme-dark .hero .tag-error {
  color: #ffc0c2;
  border-color: rgba(255, 192, 194, 0.35);
}

.page.theme-dark .hero .tag-muted {
  color: rgba(255, 255, 255, 0.86);
  border-color: rgba(255, 255, 255, 0.2);
}

.hero .tag-success {
  color: #0b7a46;
}

.hero .tag-warning {
  color: #8a5a00;
}

.hero .tag-error {
  color: #c0211a;
}

.hero .tag-muted {
  color: #4a5468;
}

.hero .tag-primary {
  color: #2f4fd0;
}

.hero .hero-status {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 卡内「查看详情 ›」：22rpx 的小字，用纯白 + 500 字重，别跟着 hint 色变灰 */
.hero-link {
  color: var(--hero-fg);
  font-weight: 500;
  opacity: 0.95;
}

/* 设备切换 chips（多设备时横向滑动） */
.chip-scroll {
  white-space: nowrap;
  margin-bottom: 22rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: var(--chip-bg);
  border: 1rpx solid var(--chip-line);
}

.chip-on {
  color: var(--chip-on-text);
  background: var(--chip-on-bg);
  border-color: var(--chip-on-line);
}

/* 模块网格：2 列 */
.mod-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -9rpx;
}

.mod {
  position: relative;
  width: 50%;
  padding: 0 9rpx;
  margin-bottom: 18rpx;
}

.mod-inner {
  height: 100%;
  min-height: 168rpx;
  padding: 24rpx 22rpx;
  border-radius: 26rpx;
  background: var(--mod-bg);
  border: 1rpx solid var(--mod-line);
  box-shadow: var(--card-shadow);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.mod-wide {
  width: 100%;
}

.mod-label {
  font-size: 22rpx;
  color: var(--text-hint);
  letter-spacing: 0.4rpx;
  display: flex;
  align-items: center;
}

/* 模块色系圆点：浅色模式显示，深色模式统一玻璃卡时隐藏 */
.mod-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: var(--mod-tone);
  flex: none;
}

.mod-value-row {
  display: flex;
  align-items: baseline;
}

.mod-value {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.mod-value-sm {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.mod-unit {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-left: 6rpx;
}

.mod-foot {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-hint);
}

/* 编辑态的删除按钮 */
.mod-del {
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--del-bg);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 44rpx;
  text-align: center;
  box-shadow: var(--del-shadow);
}

.mod-shake {
  animation: mod-shake 0.4s ease-in-out infinite alternate;
}

@keyframes mod-shake {
  from {
    transform: rotate(-0.6deg);
  }
  to {
    transform: rotate(0.6deg);
  }
}

/* 新建模块按钮 */
.add-module {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-top: 4rpx;
  border-radius: 26rpx;
  border: 1rpx dashed var(--primary-line);
  background: var(--primary-soft);
  color: var(--primary-text);
  font-size: 26rpx;
  font-weight: 600;
}

.add-module:active {
  background: var(--primary-soft-strong);
}

/* 深色下「新建模块」：v1 参数（.07 蓝底 + .42 虚线 + #9cc2ff），它是个添加位，不该比主数值显眼 */
.page.theme-dark .add-module {
  background: rgba(76, 141, 255, 0.07);
  border-color: rgba(76, 141, 255, 0.42);
  color: #9cc2ff;
}

/* 看板工具条 */
.dash-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 6rpx 4rpx 18rpx;
}

.dash-tools-title {
  font-size: 24rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.dash-tool-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  background: var(--chip-bg);
  border: 1rpx solid var(--line);
}

.dash-tool-btn-on {
  color: var(--error-text);
  background: var(--error-bg);
  border-color: var(--error-line);
}

/* ================= 模块色系（仅浅色生效，深色统一玻璃卡） ================= */

.mod-c-amber {
  --mod-bg: linear-gradient(150deg, rgba(255, 138, 61, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(255, 138, 61, 0.26);
  --mod-tone: #d9631a;
}

.mod-c-cyan {
  --mod-bg: linear-gradient(150deg, rgba(18, 181, 214, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(18, 181, 214, 0.26);
  --mod-tone: #0b8fa8;
}

.mod-c-green {
  --mod-bg: linear-gradient(150deg, rgba(18, 183, 106, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(18, 183, 106, 0.26);
  --mod-tone: #0b8f53;
}

.mod-c-purple {
  --mod-bg: linear-gradient(150deg, rgba(122, 90, 248, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(122, 90, 248, 0.26);
  --mod-tone: #5b3fd9;
}

.mod-c-yellow {
  --mod-bg: linear-gradient(150deg, rgba(245, 165, 36, 0.18), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(245, 165, 36, 0.28);
  --mod-tone: #b37505;
}

.mod-c-pink {
  --mod-bg: linear-gradient(150deg, rgba(240, 78, 140, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(240, 78, 140, 0.26);
  --mod-tone: #c9306b;
}

.mod-c-blue {
  --mod-bg: linear-gradient(150deg, rgba(76, 111, 255, 0.14), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(76, 111, 255, 0.24);
  --mod-tone: #3b5ee0;
}

.mod-c-red {
  --mod-bg: linear-gradient(150deg, rgba(240, 68, 56, 0.14), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(240, 68, 56, 0.24);
  --mod-tone: #d92d20;
}

.mod-c-violet {
  --mod-bg: linear-gradient(150deg, rgba(139, 92, 246, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(139, 92, 246, 0.26);
  --mod-tone: #6d3fd4;
}

.mod-c-orange {
  --mod-bg: linear-gradient(150deg, rgba(249, 115, 22, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(249, 115, 22, 0.26);
  --mod-tone: #c2410c;
}

.mod-c-teal {
  --mod-bg: linear-gradient(150deg, rgba(20, 184, 166, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(20, 184, 166, 0.26);
  --mod-tone: #0f766e;
}

.mod-c-sky {
  --mod-bg: linear-gradient(150deg, rgba(14, 165, 233, 0.16), rgba(255, 255, 255, 0.96) 62%);
  --mod-line: rgba(14, 165, 233, 0.26);
  --mod-tone: #0369a1;
}


/* 浅色下让「无异常」的数值也用该色系（warning / error / muted 仍走语义色） */
.mod-c-amber .t-normal,
.mod-c-cyan .t-normal,
.mod-c-green .t-normal,
.mod-c-purple .t-normal,
.mod-c-yellow .t-normal,
.mod-c-pink .t-normal,
.mod-c-blue .t-normal,
.mod-c-red .t-normal,
.mod-c-violet .t-normal,
.mod-c-orange .t-normal,
.mod-c-teal .t-normal,
.mod-c-sky .t-normal {
  color: var(--mod-tone);
}

/* 深色：所有模块回到统一卡片（不跟色系，避免 12 种颜色把藏青底搅花），圆点与彩色文字一并撤掉 */
.theme-dark .mod-c-amber,
.theme-dark .mod-c-cyan,
.theme-dark .mod-c-green,
.theme-dark .mod-c-purple,
.theme-dark .mod-c-yellow,
.theme-dark .mod-c-pink,
.theme-dark .mod-c-blue,
.theme-dark .mod-c-red,
.theme-dark .mod-c-violet,
.theme-dark .mod-c-orange,
.theme-dark .mod-c-teal,
.theme-dark .mod-c-sky {
  --mod-bg: rgba(255, 255, 255, 0.045);
  --mod-line: rgba(255, 255, 255, 0.08);
  --mod-tone: #f2f5fa;
}

.theme-dark .mod-c-amber .t-normal,
.theme-dark .mod-c-cyan .t-normal,
.theme-dark .mod-c-green .t-normal,
.theme-dark .mod-c-purple .t-normal,
.theme-dark .mod-c-yellow .t-normal,
.theme-dark .mod-c-pink .t-normal,
.theme-dark .mod-c-blue .t-normal,
.theme-dark .mod-c-red .t-normal,
.theme-dark .mod-c-violet .t-normal,
.theme-dark .mod-c-orange .t-normal,
.theme-dark .mod-c-teal .t-normal,
.theme-dark .mod-c-sky .t-normal {
  color: var(--text);
}

.theme-dark .mod-dot {
  display: none;
}

/* =========================== 底部选择弹层 =========================== */

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  /**
   * 这里必须是**固定高度**，不能只给 max-height：
   * 里面的 scroll-view 只有拿到确定高度才会自己滚。只限制最大高度时，
   * 13 个选项会把面板内容顶穿，看起来就是「弹层比屏幕还高、超出去一截」。
   * overflow: hidden 兜底，任何情况下都不让它漏到屏幕外。
   */
  height: 72vh;
  max-height: 72vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--sheet-bg);
  border-radius: 34rpx 34rpx 0 0;
  border-top: 1rpx solid var(--sheet-line);
  box-shadow: var(--sheet-shadow);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部小横条，暗示可以下拉关闭（视觉上也让面板不那么「压在屏幕上」） */
.sheet::before {
  content: '';
  flex: none;
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 0;
  border-radius: 999rpx;
  background: var(--line);
}

.sheet-hd {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx 12rpx;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text);
}

.sheet-done {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary-text);
}

.sheet-tip {
  flex: none;
  padding: 0 28rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  /* 用 sub 而不是 hint：深色主题下 hint 在深底上只有 3.9:1，小字看着发虚 */
  color: var(--text-sub);
}

/* 唯一可伸缩的滚动区：height:0 + flex:1 是 scroll-view 在 flex 容器里的标准写法 */
.sheet-body {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 28rpx 12rpx;
}

.sheet-tip-strong {
  color: var(--text);
  font-weight: 600;
}

.sheet-group-title {
  margin: 16rpx 0 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  background: var(--item-bg);
  border: 1rpx solid var(--line);
}

.sheet-item-on {
  background: var(--success-bg);
  border-color: var(--success-line);
}

.sheet-item-label {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text);
}

.sheet-item-desc {
  font-size: 21rpx;
  color: var(--text-sub);
  margin-top: 2rpx;
  font-family: 'SFMono-Regular', Consolas, Menlo, monospace;
}

/* 右侧动作做成小胶囊，比纯文字更小更收口 */
.sheet-item-add,
.sheet-item-done {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.sheet-item-add {
  color: var(--primary-text);
  background: var(--primary-soft);
  border: 1rpx solid var(--primary-line);
}

.sheet-item-done {
  color: var(--success-text);
  background: var(--success-bg);
  border: 1rpx solid var(--success-line);
}

/* 底部安全区占位 */
.safe-bottom {
  height: calc(16rpx + env(safe-area-inset-bottom));
}
